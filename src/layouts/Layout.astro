---
import '../styles/global.css';
import club from '../data/club.json';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; image?: string | null }
const { title, description = club.intro, image } = Astro.props;
const siteName = `${club.sectionName} · ${club.shortName}`;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const year = new Date().getFullYear();

const nav = [
  ['/', 'Αρχική'],
  ['/istoria/', 'Ιστορία'],
  ['/anthropoi/', 'Άνθρωποι'],
  ['/nea/', 'Νέα'],
  ['/to-athlima/', 'Το Άθλημα'],
  ['/epikoinonia/', 'Επικοινωνία'],
];
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="el_GR">
  <meta property="og:image" content={new URL(url(image || '/kydon-logo-full.png'), Astro.site).href}>
  <link rel="icon" href={url('/kydon-emblem.png')} type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Commissioner:wght@400;500;600&family=Fira+Sans+Extra+Condensed:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={url('/')}>
        <img src={url('/kydon-emblem.png')} alt="" width="46" height="46">
        <span><b>{club.sectionName}</b><small>{club.name}</small></span>
      </a>
      <nav class="links" aria-label="Κύριο μενού">
        {nav.map(([href, label]) => (
          <a href={url(href)} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <div class="wrap">
      <span>© {year} {club.name} · Τμήμα {club.sectionName}</span>
      <a href={club.mainSite} target="_blank" rel="noopener">Ιστοσελίδα του συλλόγου ↗</a>
    </div>
  </footer>
</body>
</html>

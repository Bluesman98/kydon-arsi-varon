---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Νέα" description="Νέα, αποτελέσματα αγώνων και ανακοινώσεις του τμήματος άρσης βαρών.">
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">Νέα</span>
      <h1>Νέα & αποτελέσματα</h1>
      <p>Αγώνες, διακρίσεις και ανακοινώσεις του τμήματος.</p>
    </div>
  </div>
  <section>
    <div class="wrap">
      {articles.length
        ? <div class="news-grid">{articles.map((a) => <NewsCard id={a.id} {...a.data} />)}</div>
        : <p class="lede">Δεν υπάρχουν ακόμη νέα.</p>}
    </div>
  </section>
</Layout>
